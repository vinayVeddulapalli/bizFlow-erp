# BizFlow Backend REST API (.env.example)
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://bizflow_admin:bizflow_secret_password@localhost:5432/bizflow_erp_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bizflow_redis_secret

# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bizflow_minio_admin
MINIO_SECRET_KEY=bizflow_minio_secret

# Client App URL for CORS
WEB_APP_URL=http://localhost:3002
