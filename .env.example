# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://bizflow_admin:bizflow_secret_password@localhost:5432/bizflow_erp_dev?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bizflow_redis_secret

# Security & JWT Tokens
JWT_ACCESS_SECRET="bizflow_super_secret_jwt_access_key_change_in_production_min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="bizflow_super_secret_jwt_refresh_key_change_in_production_min32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 / MinIO Object Storage
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=bizflow_minio_admin
STORAGE_SECRET_KEY=bizflow_minio_secret
STORAGE_BUCKET_NAME=bizflow-documents
