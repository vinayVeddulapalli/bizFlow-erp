# ==============================================================================
# BizFlow ERP — Comprehensive Environment Variable Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000
WEB_PORT=3000

# PostgreSQL 16 Database Configuration
POSTGRES_USER=bizflow_admin
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=bizflow_erp_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis 7 Cache & Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password

# Authentication & Cryptographic Tokens (Argon2id + JWT)
JWT_ACCESS_SECRET=replace_with_random_64_char_secret_key_here
JWT_REFRESH_SECRET=replace_with_another_different_64_char_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3-Compatible Object Storage (MinIO / AWS S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=bizflow_minio_admin
MINIO_ROOT_PASSWORD=replace_with_minio_secret_key
MINIO_BUCKET_NAME=bizflow-documents
MINIO_USE_SSL=false

# Frontend Configuration
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_TELEMETRY_DISABLED=1

# Business & Organization Defaults
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata
