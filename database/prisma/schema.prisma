// Prisma Schema for BizFlow ERP
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  phoneNumber     String?  @map("phone_number")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isActive        Boolean  @default(true) @map("is_active")
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  legalName            String?  @map("legal_name")
  gstin                String?
  pan                  String?
  currencyCode         String   @default("INR") @map("currency_code")
  fiscalYearStartMonth Int      @default(4) @map("fiscal_year_start_month")
  logoUrl              String?  @map("logo_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members               OrganizationMember[]
  branches              Branch[]
  warehouses            Warehouse[]
  categories            ProductCategory[]
  unitsOfMeasurement    UnitOfMeasurement[]
  customers             Customer[]
  suppliers             Supplier[]
  products              Product[]
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  warehouseTransfers    WarehouseTransfer[]
  stockAdjustments      StockAdjustment[]
  salesInvoices         SalesInvoice[]
  purchaseInvoices      PurchaseInvoice[]
  paymentReceipts       PaymentReceipt[]
  documentSequences     DocumentSequence[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  leads                 Lead[]
  departments           Department[]
  designations          Designation[]
  employees             Employee[]
  attendanceRecords     AttendanceRecord[]
  leaveApplications     LeaveApplication[]
  payrollPeriods        PayrollPeriod[]
  auditLogs             AuditLog[]
  PosRegister           PosRegister[]
  ExpenseCategory       ExpenseCategory[]
  Expense               Expense[]
  OtherIncomeCategory   OtherIncomeCategory[]
  OtherIncome           OtherIncome[]
  SalesOrder            SalesOrder[]
  PurchaseOrder         PurchaseOrder[]
  DeliveryChallan       DeliveryChallan[]
  CreditNote            CreditNote[]
  DebitNote             DebitNote[]
  ProductBatch          ProductBatch[]
  ProductSerial         ProductSerial[]
  UnitConversion        UnitConversion[]
  PartyPriceMatrix      PartyPriceMatrix[]
  BankAccount           BankAccount[]
  LoanAccount           LoanAccount[]
  InvoiceTemplateConfig InvoiceTemplateConfig?
  OnlineOrder           OnlineOrder[]
  Salesperson           Salesperson[]

  @@index([gstin])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  isDefault      Boolean  @default(false) @map("is_default")
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  permissions    String[] // Granular permission strings

  members OrganizationMember[]

  @@map("roles")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  gstin          String?
  addressLine1   String   @map("address_line1")
  city           String
  state          String
  stateCode      String   @map("state_code")
  postalCode     String   @map("postal_code")
  isMainBranch   Boolean  @default(false) @map("is_main_branch")
  createdAt      DateTime @default(now()) @map("created_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses       Warehouse[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([organizationId, code])
  @@map("branches")
}

model Warehouse {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  branchId       String  @map("branch_id")
  name           String
  code           String
  isDefault      Boolean @default(false) @map("is_default")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id])
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  sourceTransfers WarehouseTransfer[] @relation("SourceWarehouse")
  targetTransfers WarehouseTransfer[] @relation("TargetWarehouse")
  adjustments     StockAdjustment[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

// ==========================================
// INVENTORY & PRODUCT CATALOG (PHASE 3)
// ==========================================

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]

  @@map("product_categories")
}

model UnitOfMeasurement {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  name           String // Pieces, Kilograms, Liters, Boxes
  code           String // PCS, KGS, LTR, BOX (GST UQC Standard)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@map("units_of_measurement")
}

enum ItemType {
  GOODS
  SERVICE
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           ItemType @default(GOODS)
  name           String
  sku            String?
  barcode        String?
  hsnSacCode     String?  @map("hsn_sac_code")
  categoryId     String?  @map("category_id")
  uomId          String?  @map("uom_id")

  // Pricing & Taxation
  sellingPrice   Decimal @default(0) @map("selling_price") @db.Decimal(15, 4)
  purchasePrice  Decimal @default(0) @map("purchase_price") @db.Decimal(15, 4)
  taxRate        Decimal @default(18) @map("tax_rate") @db.Decimal(5, 2)
  isTaxInclusive Boolean @default(false) @map("is_tax_inclusive")

  // Inventory Thresholds
  minStockLevel Decimal @default(0) @map("min_stock_level") @db.Decimal(12, 4)
  reorderPoint  Decimal @default(0) @map("reorder_point") @db.Decimal(12, 4)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ProductCategory?        @relation(fields: [categoryId], references: [id])
  uom             UnitOfMeasurement?      @relation(fields: [uomId], references: [id])
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  transferItems   WarehouseTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  salesItems      SalesInvoiceItem[]
  purchaseItems   PurchaseInvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, barcode])
  @@map("products")
}

model StockLevel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  warehouseId    String   @map("warehouse_id")
  quantity       Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, warehouseId])
  @@map("stock_levels")
}

enum MovementType {
  SALES_INVOICE
  SALES_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_ADJUSTMENT
  OPENING_STOCK
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  productId      String       @map("product_id")
  warehouseId    String       @map("warehouse_id")
  movementType   MovementType @map("movement_type")
  quantity       Decimal      @db.Decimal(12, 4) // Positive for IN, Negative for OUT
  unitCost       Decimal      @map("unit_cost") @db.Decimal(15, 4)
  referenceType  String?      @map("reference_type") // e.g. "sales_invoice", "purchase_bill"
  referenceId    String?      @map("reference_id")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

model WarehouseTransfer {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  transferNumber    String   @map("transfer_number")
  sourceWarehouseId String   @map("source_warehouse_id")
  targetWarehouseId String   @map("target_warehouse_id")
  transferDate      DateTime @map("transfer_date") @db.Date
  status            String   @default("COMPLETED") // DRAFT, COMPLETED
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse               @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  items           WarehouseTransferItem[]

  @@unique([organizationId, transferNumber])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(12, 4)

  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])

  @@map("warehouse_transfer_items")
}

model StockAdjustment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  warehouseId    String   @map("warehouse_id")
  adjustmentNo   String   @map("adjustment_no")
  adjustmentDate DateTime @map("adjustment_date") @db.Date
  reason         String // Physical Count Discrepancy, Damaged Goods, Shrinkage
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id])
  items        StockAdjustmentItem[]

  @@unique([organizationId, adjustmentNo])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String  @id @default(uuid())
  adjustmentId String  @map("adjustment_id")
  productId    String  @map("product_id")
  quantity     Decimal @db.Decimal(12, 4) // Positive to add, Negative to deduct
  unitCost     Decimal @map("unit_cost") @db.Decimal(15, 4)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@map("stock_adjustment_items")
}

// ==========================================
// PARTIES (PHASE 2)
// ==========================================

enum PartyType {
  UNREGISTERED
  REGULAR
  COMPOSITION
  CONSUMER
  OVERSEAS
}

model Customer {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  companyName     String?   @map("company_name")
  email           String?
  phone           String?
  gstin           String?
  partyType       PartyType @default(UNREGISTERED) @map("party_type")
  state           String
  stateCode       String    @map("state_code")
  billingAddress  String    @map("billing_address")
  shippingAddress String?   @map("shipping_address")
  creditLimit     Decimal   @default(0) @map("credit_limit") @db.Decimal(15, 4)
  currentBalance  Decimal   @default(0) @map("current_balance") @db.Decimal(15, 4)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesInvoices   SalesInvoice[]
  paymentReceipts PaymentReceipt[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("customers")
}

model Supplier {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  companyName    String?   @map("company_name")
  email          String?
  phone          String?
  gstin          String?
  partyType      PartyType @default(REGULAR) @map("party_type")
  state          String
  stateCode      String    @map("state_code")
  billingAddress String    @map("billing_address")
  currentBalance Decimal   @default(0) @map("current_balance") @db.Decimal(15, 4)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]

  @@index([organizationId, name])
  @@map("suppliers")
}

// ==========================================
// SALES & BILLING (PHASE 2)
// ==========================================

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SalesInvoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  branchId       String        @map("branch_id")
  customerId     String        @map("customer_id")
  invoiceNumber  String        @map("invoice_number")
  invoiceDate    DateTime      @map("invoice_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(DRAFT)

  // Financial Summaries
  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(15, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 4)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 4)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 4)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(15, 4)
  totalTaxAmount Decimal @default(0) @map("total_tax_amount") @db.Decimal(15, 4)
  roundOffAmount Decimal @default(0) @map("round_off_amount") @db.Decimal(15, 4)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(15, 4)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(15, 4)
  dueAmount      Decimal @default(0) @map("due_amount") @db.Decimal(15, 4)

  placeOfSupply String    @map("place_of_supply") // 2-digit Indian State Code
  notes         String?
  terms         String?
  postedAt      DateTime? @map("posted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                     @relation(fields: [branchId], references: [id])
  customer     Customer                   @relation(fields: [customerId], references: [id])
  items        SalesInvoiceItem[]
  allocations  PaymentReceiptAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, customerId, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String  @map("invoice_id")
  productId      String? @map("product_id")
  description    String
  hsnSacCode     String? @map("hsn_sac_code")
  quantity       Decimal @db.Decimal(12, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(15, 4)
  discountPct    Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 4)
  taxableAmount  Decimal @map("taxable_amount") @db.Decimal(15, 4)
  taxRate        Decimal @map("tax_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 4)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 4)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(15, 4)
  totalAmount    Decimal @map("total_amount") @db.Decimal(15, 4)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id])

  @@map("sales_invoice_items")
}

model PaymentReceipt {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  receiptNumber  String   @map("receipt_number")
  paymentDate    DateTime @map("payment_date") @db.Date
  paymentMode    String   @map("payment_mode") // CASH, BANK_TRANSFER, UPI, CHEQUE
  amount         Decimal  @db.Decimal(15, 4)
  referenceNo    String?  @map("reference_no")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer                   @relation(fields: [customerId], references: [id])
  allocations  PaymentReceiptAllocation[]

  @@unique([organizationId, receiptNumber])
  @@map("payment_receipts")
}

model PaymentReceiptAllocation {
  id              String  @id @default(uuid())
  paymentId       String  @map("payment_id")
  invoiceId       String  @map("invoice_id")
  allocatedAmount Decimal @map("allocated_amount") @db.Decimal(15, 4)

  payment PaymentReceipt @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@map("payment_receipt_allocations")
}

// ==========================================
// PURCHASES & BILLS (PHASE 2)
// ==========================================

model PurchaseInvoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  branchId       String        @map("branch_id")
  supplierId     String        @map("supplier_id")
  billNumber     String        @map("bill_number")
  supplierBillNo String        @map("supplier_bill_no")
  billDate       DateTime      @map("bill_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(DRAFT)

  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(15, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(15, 4)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 4)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 4)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(15, 4)
  totalTaxAmount Decimal @default(0) @map("total_tax_amount") @db.Decimal(15, 4)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(15, 4)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(15, 4)
  dueAmount      Decimal @default(0) @map("due_amount") @db.Decimal(15, 4)

  notes     String?
  postedAt  DateTime? @map("posted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [branchId], references: [id])
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  items        PurchaseInvoiceItem[]

  @@unique([organizationId, billNumber])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id            String  @id @default(uuid())
  billId        String  @map("bill_id")
  productId     String? @map("product_id")
  description   String
  hsnSacCode    String? @map("hsn_sac_code")
  quantity      Decimal @db.Decimal(12, 4)
  unitCost      Decimal @map("unit_cost") @db.Decimal(15, 4)
  taxRate       Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxableAmount Decimal @map("taxable_amount") @db.Decimal(15, 4)
  cgstAmount    Decimal @default(0) @map("cgst_amount") @db.Decimal(15, 4)
  sgstAmount    Decimal @default(0) @map("sgst_amount") @db.Decimal(15, 4)
  igstAmount    Decimal @default(0) @map("igst_amount") @db.Decimal(15, 4)
  totalAmount   Decimal @map("total_amount") @db.Decimal(15, 4)

  bill    PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_items")
}

// ==========================================
// DOUBLE-ENTRY ACCOUNTING & GENERAL LEDGER
// ==========================================

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  code           String // e.g. "1100" (Cash), "1200" (Accounts Receivable)
  name           String
  category       AccountCategory
  parentId       String?         @map("parent_id")
  isSystem       Boolean         @default(false) @map("is_system")
  isActive       Boolean         @default(true) @map("is_active")
  currentBalance Decimal         @default(0) @map("current_balance") @db.Decimal(15, 4)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]          @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@map("accounts")
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model JournalEntry {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  entryNumber    String        @map("entry_number") // e.g. "JV-2026-27-00001"
  entryDate      DateTime      @map("entry_date") @db.Date
  status         JournalStatus @default(POSTED)
  referenceType  String?       @map("reference_type") // SALES_INVOICE, PURCHASE_BILL, PAYMENT_RECEIPT, MANUAL
  referenceId    String?       @map("reference_id")
  narration      String
  totalDebit     Decimal       @map("total_debit") @db.Decimal(15, 4)
  totalCredit    Decimal       @map("total_credit") @db.Decimal(15, 4)
  postedAt       DateTime      @default(now()) @map("posted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(15, 4)
  credit         Decimal @default(0) @db.Decimal(15, 4)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ==========================================
// CRM & LEAD MANAGEMENT
// ==========================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model Lead {
  id                    String     @id @default(uuid())
  organizationId        String     @map("organization_id")
  name                  String
  companyName           String?    @map("company_name")
  email                 String?
  phone                 String?
  source                String? // e.g. "Website", "Referral", "Cold Call"
  status                LeadStatus @default(NEW)
  estimatedValue        Decimal    @default(0) @map("estimated_value") @db.Decimal(15, 4)
  notes                 String?
  convertedToCustomerId String?    @map("converted_to_customer_id")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   LeadActivity[]

  @@index([organizationId, status])
  @@map("leads")
}

model LeadActivity {
  id           String    @id @default(uuid())
  leadId       String    @map("lead_id")
  activityType String    @map("activity_type") // CALL, MEETING, EMAIL, NOTE
  summary      String
  scheduledAt  DateTime? @map("scheduled_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}

// ==========================================
// HR & PAYROLL MANAGEMENT
// ==========================================

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Designation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("designations")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
}

model Employee {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  employeeCode   String           @map("employee_code") // e.g. "EMP-001"
  firstName      String           @map("first_name")
  lastName       String           @map("last_name")
  email          String?
  phone          String?
  joiningDate    DateTime         @map("joining_date") @db.Date
  status         EmploymentStatus @default(ACTIVE)
  departmentId   String?          @map("department_id")
  designationId  String?          @map("designation_id")

  // Salary Structure (Decimal precision)
  basicSalary Decimal @default(0) @map("basic_salary") @db.Decimal(15, 4)
  hra         Decimal @default(0) @db.Decimal(15, 4)
  allowances  Decimal @default(0) @db.Decimal(15, 4)
  deductions  Decimal @default(0) @db.Decimal(15, 4)

  // Statutory & Banking
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  panNumber         String? @map("pan_number")
  uanNumber         String? @map("uan_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department?        @relation(fields: [departmentId], references: [id])
  designation       Designation?       @relation(fields: [designationId], references: [id])
  attendance        AttendanceRecord[]
  leaveApplications LeaveApplication[]
  payslips          Payslip[]

  @@unique([organizationId, employeeCode])
  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  employeeId     String           @map("employee_id")
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInTime    String?          @map("check_in_time")
  checkOutTime   String?          @map("check_out_time")
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveApplication {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  employeeId     String      @map("employee_id")
  leaveType      String      @map("leave_type") // CASUAL, SICK, PAID, UNPAID
  startDate      DateTime    @map("startDate") @db.Date
  endDate        DateTime    @map("endDate") @db.Date
  totalDays      Int         @default(1) @map("total_days")
  reason         String?
  status         LeaveStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("leave_applications")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollPeriod {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  month           Int // 1 - 12
  year            Int // e.g. 2026
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?     @map("processed_at")
  totalGross      Decimal       @default(0) @map("total_gross") @db.Decimal(15, 4)
  totalDeductions Decimal       @default(0) @map("total_deductions") @db.Decimal(15, 4)
  totalNet        Decimal       @default(0) @map("total_net") @db.Decimal(15, 4)
  createdAt       DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, month, year])
  @@map("payroll_periods")
}

model Payslip {
  id              String        @id @default(uuid())
  payrollPeriodId String        @map("payroll_period_id")
  employeeId      String        @map("employee_id")
  workingDays     Int           @default(30) @map("working_days")
  presentDays     Int           @default(30) @map("present_days")
  basicSalary     Decimal       @map("basic_salary") @db.Decimal(15, 4)
  hra             Decimal       @db.Decimal(15, 4)
  allowances      Decimal       @db.Decimal(15, 4)
  grossSalary     Decimal       @map("gross_salary") @db.Decimal(15, 4)
  deductions      Decimal       @db.Decimal(15, 4)
  netSalary       Decimal       @map("net_salary") @db.Decimal(15, 4)
  status          PayrollStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@map("payslips")
}

// ==========================================
// SEQUENCES & AUDIT
// ==========================================

model DocumentSequence {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  documentType   String @map("document_type") // SALES_INVOICE, PURCHASE_BILL, PAYMENT_RECEIPT, TRANSFER, ADJUSTMENT
  prefix         String
  fiscalYear     String @map("fiscal_year") // e.g. "2026-27"
  lastNumber     Int    @default(0) @map("last_number")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, fiscalYear])
  @@map("document_sequences")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  changes        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  key            String   @id
  organizationId String   @map("organization_id")
  endpoint       String
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// VYAPAR EXTENDED MODULES
// ==========================================

// --- A. POS & Retail Counter Billing ---
model PosRegister {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String   @map("branch_id")
  name           String
  code           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     PosSession[]

  @@unique([organizationId, code])
  @@map("pos_registers")
}

model PosSession {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  registerId     String    @map("register_id")
  openedById     String    @map("opened_by_id")
  closedById     String?   @map("closed_by_id")
  openingFloat   Decimal   @default(0) @map("opening_float") @db.Decimal(15, 4)
  closingCash    Decimal?  @map("closing_cash") @db.Decimal(15, 4)
  expectedCash   Decimal?  @map("expected_cash") @db.Decimal(15, 4)
  cashDifference Decimal?  @map("cash_difference") @db.Decimal(15, 4)
  status         String    @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  notes          String?

  register PosRegister      @relation(fields: [registerId], references: [id], onDelete: Cascade)
  payments PosPaymentLine[]

  @@map("pos_sessions")
}

model PosPaymentLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id")
  invoiceId      String   @map("invoice_id")
  paymentMode    String   @map("payment_mode") // CASH, UPI, CARD, WALLET, CHEQUE, CREDIT
  amount         Decimal  @db.Decimal(15, 4)
  referenceNo    String?  @map("reference_no")
  createdAt      DateTime @default(now()) @map("created_at")

  session PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("pos_payment_lines")
}

// --- B. Expense and Other Income ---
model ExpenseCategory {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  code            String?
  accountId       String?  @map("account_id")
  isTaxDeductible Boolean  @default(true) @map("is_tax_deductible")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  categoryId     String   @map("category_id")
  branchId       String   @map("branch_id")
  expenseDate    DateTime @map("expense_date") @db.Date
  voucherNumber  String   @map("voucher_number")
  amount         Decimal  @db.Decimal(15, 4)
  isGstClaimable Boolean  @default(false) @map("is_gst_claimable")
  vendorGstin    String?  @map("vendor_gstin")
  vendorName     String?  @map("vendor_name")
  gstRate        Decimal? @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal  @default(0) @map("cgst_amount") @db.Decimal(15, 4)
  sgstAmount     Decimal  @default(0) @map("sgst_amount") @db.Decimal(15, 4)
  igstAmount     Decimal  @default(0) @map("igst_amount") @db.Decimal(15, 4)
  paymentMode    String   @map("payment_mode")
  bankAccountId  String?  @map("bank_account_id")
  receiptUrl     String?  @map("receipt_url")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  recurrenceUnit String?  @map("recurrence_unit")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, voucherNumber])
  @@map("expenses")
}

model OtherIncomeCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  accountId      String?  @map("account_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incomes      OtherIncome[]

  @@unique([organizationId, name])
  @@map("other_income_categories")
}

model OtherIncome {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  categoryId     String   @map("category_id")
  incomeDate     DateTime @map("income_date") @db.Date
  voucherNumber  String   @map("voucher_number")
  amount         Decimal  @db.Decimal(15, 4)
  source         String?
  paymentMode    String   @map("payment_mode")
  bankAccountId  String?  @map("bank_account_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     OtherIncomeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, voucherNumber])
  @@map("other_incomes")
}

// --- C. Advanced Sales & Purchase (Orders, Challans, Notes) ---
model SalesOrder {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  branchId           String    @map("branch_id")
  customerId         String    @map("customer_id")
  orderNumber        String    @map("order_number")
  orderDate          DateTime  @map("order_date") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  status             String    @default("PENDING") // PENDING, PARTIALLY_FULFILLED, COMPLETED, CANCELLED
  totalTaxable       Decimal   @map("total_taxable") @db.Decimal(15, 4)
  totalTax           Decimal   @map("total_tax") @db.Decimal(15, 4)
  totalAmount        Decimal   @map("total_amount") @db.Decimal(15, 4)
  convertedInvoiceId String?   @map("converted_invoice_id")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        SalesOrderLine[]

  @@unique([organizationId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String  @id @default(uuid())
  salesOrderId String  @map("sales_order_id")
  productId    String  @map("product_id")
  quantity     Decimal @db.Decimal(12, 4)
  fulfilledQty Decimal @default(0) @map("fulfilled_qty") @db.Decimal(12, 4)
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 4)
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal @map("tax_amount") @db.Decimal(15, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(15, 4)

  order SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("sales_order_lines")
}

model PurchaseOrder {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String    @map("branch_id")
  supplierId     String    @map("supplier_id")
  orderNumber    String    @map("order_number")
  orderDate      DateTime  @map("order_date") @db.Date
  expectedDate   DateTime? @map("expected_date") @db.Date
  status         String    @default("PLACED")
  totalAmount    Decimal   @map("total_amount") @db.Decimal(15, 4)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        PurchaseOrderLine[]

  @@unique([organizationId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  quantity        Decimal @db.Decimal(12, 4)
  unitCost        Decimal @map("unit_cost") @db.Decimal(15, 4)
  lineTotal       Decimal @map("line_total") @db.Decimal(15, 4)

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model DeliveryChallan {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String   @map("branch_id")
  customerId     String   @map("customer_id")
  challanNumber  String   @map("challan_number")
  challanDate    DateTime @map("challan_date") @db.Date
  vehicleNumber  String?  @map("vehicle_number")
  eWayBillNumber String?  @map("eway_bill_number")
  status         String   @default("DISPATCHED")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        DeliveryChallanLine[]

  @@unique([organizationId, challanNumber])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id                String  @id @default(uuid())
  deliveryChallanId String  @map("delivery_challan_id")
  productId         String  @map("product_id")
  quantity          Decimal @db.Decimal(12, 4)

  challan DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)

  @@map("delivery_challan_lines")
}

model CreditNote {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  branchId          String   @map("branch_id")
  customerId        String   @map("customer_id")
  noteNumber        String   @map("note_number")
  noteDate          DateTime @map("note_date") @db.Date
  originalInvoiceId String?  @map("original_invoice_id")
  reasonCode        String   @map("reason_code")
  taxableAmount     Decimal  @map("taxable_amount") @db.Decimal(15, 4)
  taxAmount         Decimal  @map("tax_amount") @db.Decimal(15, 4)
  totalAmount       Decimal  @map("total_amount") @db.Decimal(15, 4)
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        CreditNoteLine[]

  @@unique([organizationId, noteNumber])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String  @id @default(uuid())
  creditNoteId String  @map("credit_note_id")
  productId    String  @map("product_id")
  quantity     Decimal @db.Decimal(12, 4)
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(15, 4)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@map("credit_note_lines")
}

model DebitNote {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  branchId       String   @map("branch_id")
  supplierId     String   @map("supplier_id")
  noteNumber     String   @map("note_number")
  noteDate       DateTime @map("note_date") @db.Date
  originalBillId String?  @map("original_bill_id")
  reasonCode     String   @map("reason_code")
  taxableAmount  Decimal  @map("taxable_amount") @db.Decimal(15, 4)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(15, 4)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        DebitNoteLine[]

  @@unique([organizationId, noteNumber])
  @@map("debit_notes")
}

model DebitNoteLine {
  id          String  @id @default(uuid())
  debitNoteId String  @map("debit_note_id")
  productId   String  @map("product_id")
  quantity    Decimal @db.Decimal(12, 4)
  unitCost    Decimal @map("unit_cost") @db.Decimal(15, 4)
  lineTotal   Decimal @map("line_total") @db.Decimal(15, 4)

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@map("debit_note_lines")
}

// --- D. Advanced Inventory: Batches, Serials, Dual Units ---
model ProductBatch {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  warehouseId    String    @map("warehouse_id")
  batchNumber    String    @map("batch_number")
  mfgDate        DateTime? @map("mfg_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  mrp            Decimal   @db.Decimal(15, 4)
  purchasePrice  Decimal   @map("purchase_price") @db.Decimal(15, 4)
  salePrice      Decimal   @map("sale_price") @db.Decimal(15, 4)
  currentStock   Decimal   @default(0) @map("current_stock") @db.Decimal(12, 4)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, batchNumber, warehouseId])
  @@index([organizationId, expiryDate])
  @@map("product_batches")
}

model ProductSerial {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  productId      String    @map("product_id")
  warehouseId    String    @map("warehouse_id")
  serialNumber   String    @map("serial_number")
  status         String    @default("IN_STOCK")
  purchaseBillId String?   @map("purchase_bill_id")
  salesInvoiceId String?   @map("sales_invoice_id")
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, serialNumber])
  @@map("product_serials")
}

model UnitConversion {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  productId       String  @map("product_id")
  primaryUnitId   String  @map("primary_unit_id")
  secondaryUnitId String  @map("secondary_unit_id")
  conversionRatio Decimal @map("conversion_ratio") @db.Decimal(12, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@map("unit_conversions")
}

model PartyPriceMatrix {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  partyType      String   @map("party_type")
  partyId        String   @map("party_id")
  productId      String   @map("product_id")
  specialPrice   Decimal  @map("special_price") @db.Decimal(15, 4)
  minOrderQty    Decimal? @map("min_order_qty") @db.Decimal(12, 4)
  discountPct    Decimal? @map("discount_pct") @db.Decimal(5, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, partyId, productId])
  @@map("party_price_matrices")
}

// --- E. Cash, Bank & Loans ---
model BankAccount {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  ifscCode       String   @map("ifsc_code")
  branchName     String?  @map("branch_name")
  accountType    String   @map("account_type")
  upiId          String?  @map("upi_id")
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 4)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(15, 4)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([organizationId, accountNumber])
  @@map("bank_accounts")
}

model BankTransaction {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  bankAccountId   String    @map("bank_account_id")
  transactionDate DateTime  @map("transaction_date") @db.Date
  type            String
  amount          Decimal   @db.Decimal(15, 4)
  balanceAfter    Decimal   @map("balance_after") @db.Decimal(15, 4)
  referenceNo     String?   @map("reference_no")
  chequeNumber    String?   @map("cheque_number")
  isReconciled    Boolean   @default(false) @map("is_reconciled")
  reconciledAt    DateTime? @map("reconciled_at")
  notes           String?

  account BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("bank_transactions")
}

model LoanAccount {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  lenderName         String   @map("lender_name")
  loanNumber         String   @map("loan_number")
  principalAmount    Decimal  @map("principal_amount") @db.Decimal(15, 4)
  interestRatePct    Decimal  @map("interest_rate_pct") @db.Decimal(5, 2)
  tenureMonths       Int      @map("tenure_months")
  emiAmount          Decimal  @map("emi_amount") @db.Decimal(15, 4)
  disbursedDate      DateTime @map("disbursed_date") @db.Date
  outstandingBalance Decimal  @map("outstanding_balance") @db.Decimal(15, 4)
  status             String   @default("ACTIVE")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emiSchedules LoanEmiSchedule[]

  @@unique([organizationId, loanNumber])
  @@map("loan_accounts")
}

model LoanEmiSchedule {
  id            String    @id @default(uuid())
  loanAccountId String    @map("loan_account_id")
  installmentNo Int       @map("installment_no")
  dueDate       DateTime  @map("due_date") @db.Date
  principalPart Decimal   @map("principal_part") @db.Decimal(15, 4)
  interestPart  Decimal   @map("interest_part") @db.Decimal(15, 4)
  totalEmi      Decimal   @map("total_emi") @db.Decimal(15, 4)
  isPaid        Boolean   @default(false) @map("is_paid")
  paidDate      DateTime? @map("paid_date") @db.Date

  loan LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)

  @@map("loan_emi_schedules")
}

// --- F. Invoice Customization & Templates ---
model InvoiceTemplateConfig {
  id                String  @id @default(uuid())
  organizationId    String  @unique @map("organization_id")
  templateTheme     String  @default("MODERN_TEAL") @map("template_theme")
  paperSize         String  @default("A4") @map("paper_size")
  showLogo          Boolean @default(true) @map("show_logo")
  showSignature     Boolean @default(true) @map("show_signature")
  showQrCode        Boolean @default(true) @map("show_qr_code")
  headerColor       String  @default("#0d9488") @map("header_color")
  customTerms       String? @map("custom_terms")
  invoicePrefix     String  @default("INV") @map("invoice_prefix")
  customField1Title String? @map("custom_field1_title")
  customField2Title String? @map("custom_field2_title")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_template_configs")
}

// --- G. Online Store Orders ---
model OnlineOrder {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  orderNumber        String   @map("order_number")
  customerName       String   @map("customer_name")
  customerPhone      String   @map("customer_phone")
  customerAddress    String?  @map("customer_address")
  totalAmount        Decimal  @map("total_amount") @db.Decimal(15, 4)
  status             String   @default("NEW")
  convertedInvoiceId String?  @map("converted_invoice_id")
  placedAt           DateTime @default(now()) @map("placed_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        OnlineOrderItem[]

  @@unique([organizationId, orderNumber])
  @@map("online_orders")
}

model OnlineOrderItem {
  id            String  @id @default(uuid())
  onlineOrderId String  @map("online_order_id")
  productId     String  @map("product_id")
  productName   String  @map("product_name")
  quantity      Decimal @db.Decimal(12, 4)
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(15, 4)

  order OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)

  @@map("online_order_items")
}

// --- J. Salesperson Operations ---
model Salesperson {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String
  email          String?
  commissionPct  Decimal  @default(0) @map("commission_pct") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("salespersons")
}
