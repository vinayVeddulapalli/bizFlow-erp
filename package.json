{
  "name": "bizflow-erp",
  "version": "0.1.0",
  "private": true,
  "description": "BizFlow ERP — Complete Business Management ERP Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
