{
  "name": "bizflow-erp",
  "version": "0.1.0",
  "private": true,
  "description": "BizFlow ERP — Complete Business Management ERP Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:api": "pnpm run build:packages && pnpm --filter @bizflow/api build",
    "build:web": "pnpm run build:packages && pnpm --filter @bizflow/web build",
    "prisma:generate": "pnpm --filter @bizflow/api prisma:generate",
    "start:api": "node apps/api/dist/main",
    "start:web": "npm --prefix apps/web start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@12.21.0"
}
