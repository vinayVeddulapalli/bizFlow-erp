    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@12.21.0"
}
